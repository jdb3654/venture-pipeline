# Binary deliverables: never convert line endings (PDF byte offsets break; #15)
*.pdf binary
*.png binary
*.jpg binary
*.xlsx binary
*.ods binary
*.zip binary

# Shell scripts must keep LF endings: CRLF breaks bash (wizard skill)
*.sh text eol=lf
# Skill text files keep LF so frontmatter checks match on Windows. Text
# extensions only: a catch-all would override the binary rules above.
.agents/skills/**/*.md text eol=lf
.agents/skills/**/*.yaml text eol=lf
.agents/skills/**/*.yml text eol=lf
.claude/skills/**/*.md text eol=lf
.claude/skills/**/*.yaml text eol=lf
.claude/skills/**/*.yml text eol=lf
